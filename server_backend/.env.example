# Environment Configuration for Chit Chat Backend

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Configuration
ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/chitchat?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_here

# Client URL for CORS
CLIENT_URL=https://your-frontend-domain.com

# Additional Security (optional)
BCRYPT_SALT_ROUNDS=12
